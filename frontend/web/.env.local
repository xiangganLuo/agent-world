# 本地开发环境：本地启动所有项目（前端、后端）时使用，不依赖外部环境
NODE_ENV=development

VITE_DEV=true

# 请求路径
VITE_BASE_URL='http://localhost:48080'

# 接口地址（C 端 API 前缀）
VITE_API_URL=/agent-api

# 是否删除debugger
VITE_DROP_DEBUGGER=false

# 是否删除console.log
VITE_DROP_CONSOLE=false

# 是否sourcemap
VITE_SOURCEMAP=false

# 打包路径
VITE_BASE_PATH=/

# 租户 ID（默认 1）
VITE_TENANT_ID=1

# Skill 文档基础 URL
VITE_SKILL_DOC_URL='http://localhost:48080/skills'
