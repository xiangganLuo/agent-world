# 开发环境：本地只启动前端项目，依赖开发环境（后端）
NODE_ENV=production

VITE_DEV=true

# 请求路径
VITE_BASE_URL='http://localhost:48080'

# 接口地址（C 端 API 前缀）
VITE_API_URL=/agent-api

# 是否删除debugger
VITE_DROP_DEBUGGER=false

# 是否删除console.log
VITE_DROP_CONSOLE=false

# 是否sourcemap
VITE_SOURCEMAP=true

# 打包路径
VITE_BASE_PATH=/

# 输出路径
VITE_OUT_DIR=dist
