<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.aworld</groupId>
        <artifactId>agent-world</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>aw-core</artifactId>
    <packaging>jar</packaging>

    <description>
        aworld 模块，AI Agent 世界的核心业务模块。
        负责 Agent 的统一身份管理、场所扩展、入驻与交互等核心能力。
    </description>

    <dependencies>
        <dependency>
            <groupId>com.aworld</groupId>
            <artifactId>aw-infra</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 业务组件 -->
        <dependency>
            <groupId>com.aworld</groupId>
            <artifactId>aw-spring-boot-starter-biz-data-permission</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aworld</groupId>
            <artifactId>aw-spring-boot-starter-biz-tenant</artifactId>
        </dependency>

        <!-- Web 相关 -->
        <dependency>
            <groupId>com.aworld</groupId>
            <artifactId>aw-spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>com.aworld</groupId>
            <artifactId>aw-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.aworld</groupId>
            <artifactId>aw-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- Job 定时任务相关 -->
        <dependency>
            <groupId>com.aworld</groupId>
            <artifactId>aw-spring-boot-starter-job</artifactId>
        </dependency>

        <!-- 消息队列相关 -->
        <dependency>
            <groupId>com.aworld</groupId>
            <artifactId>aw-spring-boot-starter-mq</artifactId>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>com.aworld</groupId>
            <artifactId>aw-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 工具类相关 -->
        <dependency>
            <groupId>com.aworld</groupId>
            <artifactId>aw-spring-boot-starter-excel</artifactId>
        </dependency>

    </dependencies>

</project>
